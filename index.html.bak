    <!-- ==========================================================================
         14. BATCH TRACEABILITY SCANNER & ODISHA PINCODE CHECKER WIDGETS
         ========================================================================== -->
    <section class="trace-pincode-section">
      <div class="container">
        <div class="widget-duo-grid">
          <!-- Widget 1: Batch Traceability Scanner -->
          <div class="tool-widget-card">
            <h3>
              <svg viewBox="0 0 24 24"><path d="M3 5v4h2V5h4V3H5c-1.1 0-2 .9-2 2zm2 10H3v4c0 1.1.9 2 2 2h4v-2H5v-4zm14 4h-4v2h4c1.1 0 2-.9 2-2v-4h-2v4zm0-16h-4v2h4v4h2V5c0-1.1-.9-2-2-2z"/></svg>
              <span>Farm-to-Home Purity Scanner</span>
            </h3>
            <p>Enter the batch code printed on your product pack to trace its farm origin, milling date, and purity lab report.</p>
            
            <div class="input-with-btn">
              <input type="text" id="trace-batch-input" class="widget-input" placeholder="e.g. UF-2026-WHEAT" value="UF-2026-WHEAT">
              <button class="btn-primary" onclick="window.UnionFoods.scanBatch(document.getElementById('trace-batch-input').value)">
                <span>Verify Purity</span>
              </button>
            </div>

            <div class="sample-batches-wrap">
              <span>Try sample batches:</span>
              <button class="sample-batch-btn" onclick="document.getElementById('trace-batch-input').value='UF-2026-WHEAT'; window.UnionFoods.scanBatch('UF-2026-WHEAT');">UF-2026-WHEAT</button>
              <button class="sample-batch-btn" onclick="document.getElementById('trace-batch-input').value='UF-2026-OIL'; window.UnionFoods.scanBatch('UF-2026-OIL');">UF-2026-OIL</button>
              <button class="sample-batch-btn" onclick="document.getElementById('trace-batch-input').value='UF-2026-DAL'; window.UnionFoods.scanBatch('UF-2026-DAL');">UF-2026-DAL</button>
            </div>

            <div id="trace-result-box"></div>
          </div>

          <!-- Widget 2: Odisha Pincode Delivery Checker -->
          <div class="tool-widget-card">
            <h3>
              <svg viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z"/></svg>
              <span>Check Delivery in Your Area</span>
            </h3>
            <p>Find out estimated delivery time and shipping rates for your PIN code in Bhubaneswar, Odisha, and pan-India.</p>

            <div class="input-with-btn">
              <input type="text" id="pincode-check-input" class="widget-input" placeholder="Enter 6-digit PIN code (e.g. 751024)" maxlength="6" value="751024">
              <button class="btn-primary" onclick="window.UnionFoods.checkPin(document.getElementById('pincode-check-input').value)">
                <span>Check Status</span>
              </button>
            </div>

            <div class="sample-batches-wrap">
              <span>Quick tests:</span>
              <button class="sample-batch-btn" onclick="document.getElementById('pincode-check-input').value='751024'; window.UnionFoods.checkPin('751024');">751024 (Bhubaneswar)</button>
              <button class="sample-batch-btn" onclick="document.getElementById('pincode-check-input').value='753001'; window.UnionFoods.checkPin('753001');">753001 (Cuttack)</button>
            </div>

            <div id="pincode-result-box"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================================
         15. FAQ ACCORDION & ANIMATED COUNTERS
         ========================================================================== -->
    <section class="faq-section">
      <div class="container">
        <div class="section-title-wrap section-title-center">
          <span class="section-tag">Frequently Asked Questions</span>
          <h2 class="section-title">Everything You Need to Know</h2>
        </div>

        <div class="faq-container">
          <!-- FAQ 1 -->
          <div class="faq-item open">
            <button class="faq-question-btn">
              <span>How does Union Foods ensure 100% purity without chemicals?</span>
              <svg class="faq-icon-arrow" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
            </button>
            <div class="faq-answer-box" style="max-height: 180px;">
              All our grains and pulses undergo optical sortex sorting and 5-stage mechanical cleaning. Our cooking oils are extracted using cold-press and multi-stage temperature-controlled filtration with zero added artificial preservatives or argemone contaminants.
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="faq-item">
            <button class="faq-question-btn">
              <span>What is your delivery coverage in Bhubaneswar and Odisha?</span>
              <svg class="faq-icon-arrow" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
            </button>
            <div class="faq-answer-box">
              We offer same-day and next-day express delivery in Bhubaneswar, Cuttack, and Puri. Statewide delivery across all 30 districts of Odisha completes within 24 to 48 hours. Orders above ₹499 enjoy 100% free home delivery.
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="faq-item">
            <button class="faq-question-btn">
              <span>Why are Union Foods pulses described as unpolished?</span>
              <svg class="faq-icon-arrow" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
            </button>
            <div class="faq-answer-box">
              Commercial polishing involves water, marble powder, or toxic oils that strip off the natural protein-rich outer layer. Union Foods pulses are 100% unpolished, retaining natural fiber, original taste, and nutritional integrity.
            </div>
          </div>

          <!-- FAQ 4 -->
          <div class="faq-item">
            <button class="faq-question-btn">
              <span>Can I place bulk orders for restaurants or retail distribution?</span>
              <svg class="faq-icon-arrow" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
            </button>
            <div class="faq-answer-box">
              Yes! We cater to distributors, grocery marts, hotels, and cloud kitchens with customized wholesale rates and bulk packaging (15kg tins, 25kg sacks). Contact us at <strong>info@unionfoods.in</strong> or phone <strong>+91 98765 43210</strong>.
            </div>
          </div>
        </div>

        <!-- Animated Statistics Counter Strip -->
        <div class="stats-strip">
          <div class="stat-col">
            <div class="stat-num" data-target="50000" data-suffix="+">0</div>
            <div class="stat-label">Happy Families Served</div>
          </div>
          <div class="stat-col">
            <div class="stat-num" data-target="100" data-suffix="%">0</div>
            <div class="stat-label">Purity Lab Tested</div>
          </div>
          <div class="stat-col">
            <div class="stat-num" data-target="30" data-suffix="+">0</div>
            <div class="stat-label">Odisha Districts Covered</div>
          </div>
          <div class="stat-col">
            <div class="stat-num" data-target="15" data-suffix="+">0</div>
            <div class="stat-label">Industry Quality Awards</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================================
