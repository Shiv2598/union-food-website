       19. MODALS: QUICK VIEW, RECIPES, CERTS, CHECKOUT, CONFIRMATION
       ========================================================================== -->
  
  <!-- Product Quick View Modal -->
  <div id="quickview-modal" class="modal-overlay" role="dialog" aria-modal="true">
    <div class="modal-content-box" style="max-width: 780px;">
      <button class="modal-close-btn" aria-label="Close modal">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
      <div id="quickview-body"></div>
    </div>
  </div>

  <!-- Recipe Video & Dynamic Serving Scaler Modal -->
  <div id="recipe-modal" class="modal-overlay" role="dialog" aria-modal="true">
    <div class="modal-content-box" style="max-width: 680px; padding: 2rem;">
      <button class="modal-close-btn" aria-label="Close modal">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>

      <span style="font-size: 0.78rem; font-weight: 800; color: var(--primary-orange); text-transform: uppercase;">Chef's Special Recipe</span>
      <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--text-heading); margin: 0.3rem 0 1rem;">
        Healthy Vegetable Kadai with Union Foods Atta Rotis
      </h2>

      <!-- Simulated Recipe Video Player -->
      <div style="position: relative; width: 100%; height: 230px; background: #000; border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 1.25rem;">
        <img src="assets/images/recipe-curry.svg" alt="Video preview" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.85;">
        <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(0,0,0,0.4); color: #fff;">
          <button style="width: 54px; height: 54px; border-radius: 50%; background: var(--primary-orange); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,0.5);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <span style="font-size: 0.82rem; font-weight: 700; margin-top: 0.5rem;">Watch HD Cooking Masterclass (5:20)</span>
        </div>
      </div>

      <!-- Serving Scaler Toolbar -->
      <div style="display: flex; align-items: center; justify-content: space-between; background: var(--bg-warm); padding: 0.85rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.2rem;">
        <div>
          <strong style="color: var(--text-heading); font-size: 0.9rem;">Adjust Servings:</strong>
          <span style="font-size: 0.82rem; color: var(--text-muted); display: block;">Quantities recalculate automatically</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <button class="nav-arrow-btn" style="width: 30px; height: 30px;" onclick="window.UnionFoods.adjustServings(-1)">-</button>
          <span id="recipe-servings-val" style="font-size: 1.1rem; font-weight: 800; min-width: 24px; text-align: center; color: var(--primary-orange);">4</span>
          <button class="nav-arrow-btn" style="width: 30px; height: 30px;" onclick="window.UnionFoods.adjustServings(1)">+</button>
        </div>
      </div>

      <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--text-heading); margin-bottom: 0.6rem;">Ingredients Checklist:</h3>
      <ul id="recipe-ingredients-list" style="margin-bottom: 1.5rem;"></ul>

      <button class="btn-primary" style="width: 100%; justify-content: center;" onclick="window.UnionFoods.addToCart('uf-atta-1', 1); window.UnionFoods.addToCart('uf-oil-1', 1);">
        <span>Add All Required Union Foods Ingredients to Cart</span>
      </button>
    </div>
  </div>

  <!-- Facility Tour & Story Modal -->
  <div id="facility-modal" class="modal-overlay" role="dialog" aria-modal="true">
    <div class="modal-content-box" style="max-width: 650px; padding: 2rem;">
      <button class="modal-close-btn" aria-label="Close modal">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
      <span style="font-size: 0.78rem; font-weight: 800; color: var(--primary-orange); text-transform: uppercase;">Our Story &amp; Facility</span>
      <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--text-heading); margin: 0.3rem 0 1rem;">
        Union Foods Processing Plant, Bhubaneswar
      </h2>
      <img src="assets/images/facility.svg" alt="Union Foods Plant" style="border-radius: var(--radius-sm); margin-bottom: 1.25rem; width: 100%;">
      <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 1rem;">
        Established with a commitment to uncompromised food purity, Union Foods operates advanced European optical sortex sorters, multi-stage cold extraction expellers, and automated hygienic nitrogen-flushed pouch lines right here in Odisha.
      </p>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.85rem; font-weight: 600; color: var(--text-heading);">
        <div style="background: var(--bg-warm); padding: 0.6rem 0.8rem; border-radius: 6px;">🌱 100% Solar-Powered Plant</div>
        <div style="background: var(--bg-warm); padding: 0.6rem 0.8rem; border-radius: 6px;">💧 Zero Effluent Discharge</div>
        <div style="background: var(--bg-warm); padding: 0.6rem 0.8rem; border-radius: 6px;">🛡️ Contactless Packing</div>
        <div style="background: var(--bg-warm); padding: 0.6rem 0.8rem; border-radius: 6px;">🌾 Direct Farmer Procurement</div>
      </div>
    </div>
  </div>

  <!-- Certifications Verification Modal -->
  <div id="certs-modal" class="modal-overlay" role="dialog" aria-modal="true">
    <div class="modal-content-box" style="max-width: 600px; padding: 2rem;">
      <button class="modal-close-btn" aria-label="Close modal">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
      <span style="font-size: 0.78rem; font-weight: 800; color: #16a34a; text-transform: uppercase;">Official Quality Accreditation</span>
      <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--text-heading); margin: 0.3rem 0 1.25rem;">
        Our Food Safety &amp; Quality Certifications
      </h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div style="display: flex; gap: 1rem; align-items: center; background: #eff6ff; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid #bfdbfe;">
          <img src="assets/images/cert-fssai.svg" style="width: 58px; height: 58px;" alt="FSSAI">
          <div>
            <h4 style="color: #1e3a8a; font-weight: 800;">FSSAI Central Food Safety License</h4>
            <p style="font-size: 0.82rem; color: #3b82f6;">License No: 12026999000142 | Valid through 2029</p>
          </div>
        </div>
        <div style="display: flex; gap: 1rem; align-items: center; background: #f0f9ff; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid #bae6fd;">
          <img src="assets/images/cert-iso.svg" style="width: 58px; height: 58px;" alt="ISO">
          <div>
            <h4 style="color: #0369a1; font-weight: 800;">ISO 9001:2015 &amp; ISO 22000 FSMS</h4>
            <p style="font-size: 0.82rem; color: #0284c7;">Audited International Food Safety Management Standard</p>
          </div>
        </div>
        <div style="display: flex; gap: 1rem; align-items: center; background: #f0fdf4; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid #bbf7d0;">
          <img src="assets/images/cert-haccp.svg" style="width: 58px; height: 58px;" alt="HACCP">
          <div>
            <h4 style="color: #166534; font-weight: 800;">HACCP Certified (Hazard Analysis Critical Control Point)</h4>
            <p style="font-size: 0.82rem; color: #16a34a;">Zero Microbial Contamination Guarantee</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search Modal -->
  <div id="search-modal" class="modal-overlay" role="dialog" aria-modal="true">
    <div class="modal-content-box" style="max-width: 560px; padding: 1.5rem;">
      <button class="modal-close-btn" aria-label="Close modal">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
      <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-heading); margin-bottom: 0.85rem;">Search Union Foods</h3>
      <input type="search" id="quick-search-input" class="widget-input" style="width: 100%; margin-bottom: 1rem;" placeholder="Search for Sunflower Oil, Atta, Moong Dal, Spices...">
      <div id="search-results-list" style="max-height: 260px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem;">
        <p style="font-size: 0.85rem; color: var(--text-muted); text-align: center; padding: 1.5rem 0;">Type to see instant search results.</p>
      </div>
    </div>
  </div>

  <!-- Simulated Quick Order Checkout Modal -->
  <div id="checkout-modal" class="modal-overlay" role="dialog" aria-modal="true">
    <div class="modal-content-box" style="max-width: 580px; padding: 2rem;">
      <button class="modal-close-btn" aria-label="Close modal">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
      <span style="font-size: 0.78rem; font-weight: 800; color: var(--primary-orange); text-transform: uppercase;">Fast Checkout</span>
      <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--text-heading); margin: 0.3rem 0 1rem;">Complete Your Order</h2>
      
      <div id="checkout-summary-box"></div>

      <form onsubmit="window.UnionFoods.completeOrder(event)">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
          <input type="text" class="widget-input" placeholder="Full Name" required value="Priya Mishra">
          <input type="tel" class="widget-input" placeholder="Phone Number" required value="+91 98765 43210">
        </div>
        <input type="text" class="widget-input" style="width: 100%; margin-bottom: 0.75rem;" placeholder="Delivery Address (Flat / House No / Street)" required value="Flat 402, Royal Palms, Patia">
        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
          <input type="text" class="widget-input" placeholder="City" value="Bhubaneswar, Odisha" readonly>
          <input type="text" class="widget-input" placeholder="PIN Code" value="751024" required>
        </div>

        <div style="background: var(--bg-warm); padding: 0.85rem; border-radius: var(--radius-sm); margin-bottom: 1.25rem;">
          <label style="font-size: 0.85rem; font-weight: 700; color: var(--text-heading); display: block; margin-bottom: 0.4rem;">Select Payment Method:</label>
          <div style="display: flex; gap: 1rem; font-size: 0.85rem; color: var(--text-heading);">
            <label style="display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
              <input type="radio" name="paymethod" checked style="accent-color: var(--primary-orange);">
              <span>UPI / QR / GPay</span>
            </label>
            <label style="display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
              <input type="radio" name="paymethod" style="accent-color: var(--primary-orange);">
              <span>Cash on Delivery (COD)</span>
            </label>
          </div>
        </div>

        <button type="submit" class="btn-primary" style="width: 100%; justify-content: center;">
          <span>Confirm &amp; Place Order</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        </button>
      </form>
    </div>
  </div>

  <!-- Order Confirmation Screen -->
  <div id="order-confirmation-modal" class="modal-overlay" role="dialog" aria-modal="true">
    <div class="modal-content-box" style="max-width: 520px; padding: 2.2rem; text-align: center;">
      <button class="modal-close-btn" aria-label="Close modal">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>

      <div style="width: 72px; height: 72px; border-radius: 50%; background: #dcfce7; color: #16a34a; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem;">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
      </div>

      <h2 style="font-size: 1.6rem; font-weight: 800; color: var(--text-heading); margin-bottom: 0.35rem;">Order Confirmed!</h2>
      <p style="font-size: 0.92rem; color: var(--text-muted); margin-bottom: 1.5rem;">
        Thank you for choosing Union Foods. Your daily essentials are being freshly packed and dispatched from our Bhubaneswar unit.
      </p>

      <div style="background: var(--bg-warm); padding: 1.25rem; border-radius: var(--radius-sm); text-align: left; margin-bottom: 1.5rem; font-size: 0.88rem;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
          <span style="color: var(--text-muted);">Order ID:</span>
          <strong id="conf-order-id" style="color: var(--primary-orange);">UF-782910</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
          <span style="color: var(--text-muted);">Date:</span>
          <span id="conf-order-date">Nov 12, 2026</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
          <span style="color: var(--text-muted);">Estimated Delivery:</span>
          <strong style="color: #16a34a;">Tomorrow, by 11:00 AM</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--text-muted);">Delivery Hub:</span>
          <span>Bhubaneswar Express Hub</span>
        </div>
      </div>

      <button class="btn-primary" style="width: 100%; justify-content: center;" onclick="document.getElementById('order-confirmation-modal').classList.remove('active')">
        <span>Back to Home</span>
      </button>
    </div>
  </div>

  <!-- ==========================================================================
       20. FLOATING DOCK: WHATSAPP & BACK TO TOP
       ========================================================================== -->
  <div class="floating-actions-dock" aria-label="Quick Actions">
    <button class="whatsapp-float-btn" onclick="window.UnionFoods.openWhatsApp()" title="Chat on WhatsApp" aria-label="WhatsApp Chat">
      <svg viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.41a8.167 8.167 0 0 1 2.4 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.03-1.24-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.71 4.3 3.8 2.53 1.09 2.53.73 2.99.69.46-.04 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.29z"/></svg>
    </button>

    <button id="back-to-top-btn" class="back-to-top-btn" title="Back to Top" aria-label="Scroll back to top">
      <svg class="scroll-ring-svg" viewBox="0 0 48 48">
        <circle cx="24" cy="24" r="23" class="scroll-ring-circle"/>
      </svg>
      <svg viewBox="0 0 24 24"><path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/></svg>
    </button>
  </div>

  <!-- Toast Notification Mount Point -->
  <div id="toast-container" aria-live="polite"></div>

  <!-- Primary JavaScript Logic -->
  <script src="js/script.js"></script>

  <!-- Real-time search script integration -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('quick-search-input');
      const searchResults = document.getElementById('search-results-list');
      if (searchInput && searchResults) {
        searchInput.addEventListener('input', (e) => {
          const q = e.target.value.toLowerCase().trim();
          if (!q) {
            searchResults.innerHTML = '<p style="font-size: 0.85rem; color: var(--text-muted); text-align: center; padding: 1.5rem 0;">Type to see instant search results.</p>';
            return;
          }
          // Query products
          const matches = [
            { name: 'Refined Sunflower Oil (1L)', id: 'uf-oil-1', price: '₹145', cat: 'Cooking Oil', img: 'assets/images/sunflower-oil.svg' },
            { name: 'Premium Sharbati Atta (5Kg)', id: 'uf-atta-1', price: '₹245', cat: 'Flour & Grains', img: 'assets/images/premium-atta.svg' },
            { name: 'Unpolished Moong Dal (1Kg)', id: 'uf-moong-1', price: '₹135', cat: 'Pulses & Dal', img: 'assets/images/moong-dal.svg' },
            { name: 'Desi Chana Dal (1Kg)', id: 'uf-chana-1', price: '₹115', cat: 'Pulses & Dal', img: 'assets/images/chana-dal.svg' },
            { name: 'Kachi Ghani Mustard Oil (1L)', id: 'uf-mustard-1', price: '₹155', cat: 'Cooking Oil', img: 'assets/images/mustard-oil.svg' },
            { name: 'Pure Turmeric Powder (500g)', id: 'uf-haldi-1', price: '₹95', cat: 'Spices', img: 'assets/images/haldi-powder.svg' }
          ].filter(p => p.name.toLowerCase().includes(q) || p.cat.toLowerCase().includes(q));

          if (matches.length === 0) {
            searchResults.innerHTML = '<p style="font-size: 0.85rem; color: #dc2626; text-align: center; padding: 1rem 0;">No matching products found.</p>';
            return;
          }

          searchResults.innerHTML = matches.map(m => `
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.8rem; background: var(--bg-warm); border-radius: var(--radius-sm); cursor: pointer;" onclick="window.UnionFoods.openQuickView('${m.id}'); document.getElementById('search-modal').classList.remove('active');">
              <div style="display: flex; align-items: center; gap: 0.65rem;">
                <img src="${m.img}" alt="${m.name}" style="width: 36px; height: 36px; object-fit: contain;">
                <div>
                  <div style="font-size: 0.88rem; font-weight: 700; color: var(--text-heading);">${m.name}</div>
                  <span style="font-size: 0.75rem; color: var(--text-muted);">${m.cat}</span>
                </div>
              </div>
              <strong style="color: var(--primary-orange);">${m.price}</strong>
            </div>
          `).join('');
        });
      }
    });
  </script>
</body>
</html>
