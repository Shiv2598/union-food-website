<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Union Foods | Pure Food for a Healthier Life | Bhubaneswar, Odisha</title>
  
  <!-- SEO & Meta Tags -->
  <meta name="description" content="Union Foods brings purity, nutrition, and taste to every home with our premium range of Cooking Oils, Chakki Atta, Pulses, and Spices. Hygienically processed and 100% natural.">
  <meta name="keywords" content="Union Foods, Sunflower Oil, Sharbati Atta, Moong Dal, Chana Dal, Odisha Food Products, Bhubaneswar, Healthy Grocery">
  <meta name="author" content="Union Foods Private Limited">
  
  <!-- Google Fonts: Poppins (Clean Modern UI) & Playfair Display (Food/Atta Branding) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,800;0,900;1,700&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Primary CSS Stylesheet -->
  <link rel="stylesheet" href="css/style.css">
</head>
<body>

  <!-- Top Scroll Progress Bar -->
  <div id="scroll-progress" aria-hidden="true"></div>

  <!-- Accessibility Skip Link -->
  <a href="#main-content" class="skip-to-content">Skip to main content</a>

  <!-- ==========================================================================
       1. TOP UTILITY BAR (Reference Design)
       ========================================================================== -->
  <aside class="top-bar" aria-label="Quick contact and social links">
    <div class="container">
      <div class="top-info-list">
        <a href="tel:+919876543210" class="top-info-item" title="Call Us">
          <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          <span>+91 98765 43210</span>
        </a>
        <a href="mailto:info@unionfoods.in" class="top-info-item" title="Email Support">
          <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span>info@unionfoods.in</span>
        </a>
        <a href="#locations" class="top-info-item" title="View Location on Map">
          <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          <span>Bhubaneswar, Odisha (View Map)</span>
        </a>
      </div>

      <div class="top-actions">
        <div class="top-social-wrap">
          <span>Follow Us:</span>
          <div class="social-icons-group">
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="Facebook">
              <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="Instagram">
              <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="Twitter / X">
              <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="YouTube">
              <svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="LinkedIn">
              <svg viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          </div>
        </div>

        <!-- Quick Switchers: Theme & Language -->
        <div class="top-quick-tools">
          <button id="theme-toggle-btn" class="tool-badge-btn" title="Toggle Light/Dark Theme">
            <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/></svg>
            <span>Theme</span>
          </button>
          <button id="lang-toggle-btn" class="tool-badge-btn" title="Change Language">
            <span>EN</span>
          </button>
        </div>
      </div>
    </div>
  </aside>

  <!-- ==========================================================================
       2. MAIN NAVIGATION (Header)
       ========================================================================= -->
  <header class="main-header" role="banner">
    <div class="container header-container">
      <!-- Brand Logo -->
      <a href="#home" class="brand-logo-link" aria-label="Union Foods Home">
        <img src="assets/images/logo.svg" alt="Union Foods Logo" class="brand-logo-img">
      </a>

      <!-- Desktop Navigation Menu -->
      <nav id="desktop-nav" class="desktop-nav" role="navigation" aria-label="Main menu">
        <a href="#home" class="nav-link active">Home</a>
        <a href="#about" class="nav-link">About Us</a>
        
        <!-- Products Dropdown -->
        <div class="nav-dropdown-item">
          <a href="#products-section" class="nav-link">
            <span>Products</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
          </a>
          <div class="dropdown-menu">
            <a href="#products-section" class="dropdown-link" onclick="window.UnionFoods.currentCategory='oil'">
              <svg viewBox="0 0 24 24"><path d="M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8z"/></svg>
              <span>Cooking Oils</span>
            </a>
            <a href="#products-section" class="dropdown-link" onclick="window.UnionFoods.currentCategory='flour'">
              <svg viewBox="0 0 24 24"><path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1z"/></svg>
              <span>Flour & Grains</span>
            </a>
            <a href="#products-section" class="dropdown-link" onclick="window.UnionFoods.currentCategory='pulses'">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
              <span>Pulses & Dal</span>
            </a>
            <a href="#products-section" class="dropdown-link" onclick="window.UnionFoods.currentCategory='spices'">
              <svg viewBox="0 0 24 24"><path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3z"/></svg>
              <span>Pure Spices</span>
            </a>
          </div>
        </div>

        <a href="#recipes" class="nav-link">Recipes</a>
        <a href="#why-choose" class="nav-link">Sustainability</a>
        <a href="#locations" class="nav-link">Locations</a>
        <a href="#facility-tour-btn" class="nav-link" onclick="window.UnionFoods.openFacilityModal()">Gallery</a>
        <a href="#news-events" class="nav-link">News</a>
        <a href="#contact" class="nav-link">Contact</a>
      </nav>

      <!-- Header Actions -->
      <div class="header-actions">
        <!-- Search Trigger -->
        <button class="action-icon-btn" onclick="document.getElementById('search-modal').classList.add('active')" title="Search Food Items" aria-label="Search">
          <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        </button>

        <!-- Cart Trigger with Counter Badge -->
        <button class="action-icon-btn" onclick="window.UnionFoods.openCartDrawer()" title="View Shopping Cart" aria-label="Cart">
          <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
          <span id="cart-count-badge" class="action-badge">0</span>
        </button>

        <!-- Order Now CTA Button -->
        <button class="btn-primary" onclick="window.UnionFoods.startCheckout()">
          <span>Order Now</span>
        </button>

        <!-- Mobile Hamburger Toggle -->
        <button id="hamburger-toggle" class="hamburger-toggle" aria-label="Toggle navigation" aria-expanded="false">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==========================================================================
       3. SECTION 16: INFINITE SCROLLING FOOD IMAGE GALLERY (BELOW NAVBAR)
       ========================================================================== -->
  <section class="food-ticker-section" aria-label="Popular Dishes & Delicacies">
    <div class="ticker-wrapper">
      <div class="ticker-track">
        <!-- Loop Item 1 -->
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-puri-sabji.svg" alt="Crispy Puri & Aloo Dum">
          <div class="ticker-overlay">
            <span class="ticker-tag">Breakfast Favorite</span>
            <span class="ticker-name">Crispy Puri & Aloo Dum</span>
          </div>
        </div>
        <!-- Loop Item 2 -->
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-paneer.svg" alt="Shahi Paneer Masala">
          <div class="ticker-overlay">
            <span class="ticker-tag">Rich & Creamy</span>
            <span class="ticker-name">Shahi Paneer Masala</span>
          </div>
        </div>
        <!-- Loop Item 3 -->
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-biryani.svg" alt="Vegetable Dum Biryani">
          <div class="ticker-overlay">
            <span class="ticker-tag">Special Weekend Dish</span>
            <span class="ticker-name">Vegetable Dum Biryani</span>
          </div>
        </div>
        <!-- Loop Item 4 -->
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-dosa.svg" alt="Crispy Masala Dosa">
          <div class="ticker-overlay">
            <span class="ticker-tag">South Indian Crunch</span>
            <span class="ticker-name">Crispy Masala Dosa</span>
          </div>
        </div>
        <!-- Loop Item 5 -->
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-samosa.svg" alt="Golden Desi Samosas">
          <div class="ticker-overlay">
            <span class="ticker-tag">Evening Snack</span>
            <span class="ticker-name">Golden Desi Samosas</span>
          </div>
        </div>
        <!-- Loop Item 6 -->
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-lassi.svg" alt="Kesar Mango Lassi">
          <div class="ticker-overlay">
            <span class="ticker-tag">Refreshing Beverage</span>
            <span class="ticker-name">Kesar Mango Lassi</span>
          </div>
        </div>
        <!-- Loop Item 7 -->
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-salad.svg" alt="Organic Sprout Salad">
          <div class="ticker-overlay">
            <span class="ticker-tag">Health & Fitness</span>
            <span class="ticker-name">Organic Sprout Salad</span>
          </div>
        </div>
        <!-- Loop Item 8 -->
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-gulabjamun.svg" alt="Hot Gulab Jamun">
          <div class="ticker-overlay">
            <span class="ticker-tag">Desi Ghee Dessert</span>
            <span class="ticker-name">Hot Gulab Jamun</span>
          </div>
        </div>

        <!-- Duplicated for seamless infinite loop without gaps -->
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-puri-sabji.svg" alt="Crispy Puri & Aloo Dum">
          <div class="ticker-overlay"><span class="ticker-tag">Breakfast Favorite</span><span class="ticker-name">Crispy Puri & Aloo Dum</span></div>
        </div>
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-paneer.svg" alt="Shahi Paneer Masala">
          <div class="ticker-overlay"><span class="ticker-tag">Rich & Creamy</span><span class="ticker-name">Shahi Paneer Masala</span></div>
        </div>
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-biryani.svg" alt="Vegetable Dum Biryani">
          <div class="ticker-overlay"><span class="ticker-tag">Special Weekend Dish</span><span class="ticker-name">Vegetable Dum Biryani</span></div>
        </div>
        <div class="ticker-card" onclick="window.UnionFoods.openRecipeModal()">
          <img src="assets/images/food-dosa.svg" alt="Crispy Masala Dosa">
          <div class="ticker-overlay"><span class="ticker-tag">South Indian Crunch</span><span class="ticker-name">Crispy Masala Dosa</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Wrapper -->
  <main id="main-content">

    <!-- ==========================================================================
         4. HERO SECTION (Reference Design Accurate)
         ========================================================================== -->
    <section id="home" class="hero-section">
      <div class="container">
        <div class="hero-grid">
          <!-- Left Column Content -->
          <div class="hero-content">
            <div class="hero-badge">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span>NATURAL &amp; DELICIOUS</span>
            </div>

            <h1 class="hero-title">
              Pure Food for a
              <span class="highlight-gold">Healthier Life</span>
            </h1>

            <p class="hero-description">
              Discover a range of high-quality, hygienic and tasty food products for you and your family. 100% natural, unadulterated, and freshly packaged from source.
            </p>

            <div class="hero-btn-group">
              <a href="#featured-products" class="btn-primary">
                <span>Explore Products</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
              </a>
              <button class="btn-secondary" onclick="window.UnionFoods.openFacilityModal()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                <span>Our Story</span>
              </button>
            </div>
          </div>

          <!-- Right Column Showcase of Flagship Products -->
          <div class="hero-showcase-wrap">
            <img src="assets/images/hero-showcase.svg" alt="Union Foods Sunflower Oil, Premium Atta, Moong Dal, Chana Dal Showcase" class="hero-main-img">
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================================================
         5. VALUE PROPOSITION STRIP (6 Icon Pillars matching reference)
         ========================================================================== -->
    <section class="value-pillars-section" aria-label="Why Union Foods is trusted">
      <div class="container">
        <div class="value-pillars-grid">
          <!-- Pillar 1 -->
          <div class="pillar-item">
            <div class="pillar-icon-box">
              <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
            </div>
            <div class="pillar-title">100% Hygienic &amp; Safe</div>
          </div>
          <!-- Pillar 2 -->
          <div class="pillar-item">
            <div class="pillar-icon-box">
              <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            </div>
            <div class="pillar-title">Premium Quality</div>
          </div>
          <!-- Pillar 3 -->
          <div class="pillar-item">
            <div class="pillar-icon-box">
              <svg viewBox="0 0 24 24"><path d="M4 11h5V5H4v6zm0 7h5v-6H4v6zm6 0h5v-6h-5v6zm6 0h5v-6h-5v6zm-6-7h5V5h-5v6zm6-6v6h5V5h-5z"/></svg>
            </div>
            <div class="pillar-title">Wide Range of Products</div>
          </div>
          <!-- Pillar 4 -->
          <div class="pillar-item">
            <div class="pillar-icon-box">
              <svg viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
            </div>
            <div class="pillar-title">Reliable Delivery</div>
          </div>
          <!-- Pillar 5 -->
