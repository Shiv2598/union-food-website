  <div id="cart-drawer-overlay" class="cart-drawer-overlay" aria-hidden="true"></div>
  <aside id="cart-drawer" class="cart-drawer" aria-label="Shopping Cart Drawer">
    <div class="cart-drawer-header">
      <h3>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="var(--primary-orange)"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
        <span>Your Shopping Cart</span>
      </h3>
      <button class="modal-close-btn" style="position: static;" onclick="window.UnionFoods.closeCartDrawer()" aria-label="Close cart">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
    </div>

    <!-- Free Delivery Progress Bar -->
    <div class="free-shipping-meter">
      <div id="free-shipping-text">Add ₹499 more for FREE Express Delivery!</div>
      <div class="meter-bar-bg">
        <div id="free-shipping-fill" class="meter-bar-fill" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Scrollable Items Container -->
    <div id="cart-items-container" class="cart-items-container"></div>

    <!-- Cart Footer & Calculation -->
    <div class="cart-drawer-footer">
      <form id="cart-coupon-form" class="cart-coupon-form">
        <input type="text" id="cart-coupon-input" class="cart-coupon-input" placeholder="Promo code (e.g. UNION10)">
        <button type="submit" class="btn-primary" style="padding: 0.45rem 1rem; font-size: 0.82rem;">Apply</button>
      </form>

      <div class="cart-totals-summary">
        <div class="summary-row">
          <span>Subtotal</span>
          <span id="cart-subtotal">₹0</span>
        </div>
        <div class="summary-row">
          <span>Delivery Fee</span>
          <span id="cart-shipping">₹50</span>
        </div>
        <div class="summary-row" style="color: #16a34a;">
          <span>Discount</span>
          <span id="cart-discount">-₹0</span>
        </div>
        <div class="summary-row grand-total">
          <span>Grand Total</span>
          <span id="cart-total" style="color: var(--primary-orange);">₹0</span>
        </div>
      </div>

      <button class="btn-primary" style="width: 100%; justify-content: center;" onclick="window.UnionFoods.startCheckout()">
        <span>Proceed to Checkout</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
      </button>
    </div>
  </aside>

